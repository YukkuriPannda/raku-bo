# Node modules
node_modules/
*/node_modules/

# Environment variables
# 派生ファイル（.env.production / .dev.vars.bak など）もまとめて除外する。
# 末尾に何か付いただけのコピーが追跡対象になると、SERVICE_ROLE_KEY や
# GOOGLE_CLIENT_SECRET がそのままコミットされてしまう。
.env
.env.*
.dev.vars
.dev.vars.*

# ただし雛形は追跡する
!.env.example
!.dev.vars.example

# Cloudflare Workers
.wrangler/

# Expo
mobile/.expo/
mobile/dist/
mobile/web-build/

# Build outputs
dist/
build/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Claude worktrees
.claude/worktrees/

# Validation samples (may contain personal data)
validation/gemini-ocr/sample.jpg

# 検証用に置いたレシート実物（個人情報を含む）
/IMG_*.jpg
