{
  "expo": {
    "name": "らく〜ぼ",
    "slug": "raku-bo",
    "version": "1.0.0",
    "scheme": "rakubo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rakubo.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.rakubo.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "レシートを撮影して家計簿に記録するためにカメラを使用します。"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "レシートを撮影して家計簿に記録するためにカメラを使用します。",
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RemainingBudget",
              "label": "今月あと○○円",
              "minWidth": "120dp",
              "minHeight": "120dp",
              "maxResizeWidth": "120dp",
              "maxResizeHeight": "120dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "description": "今月の残り使える額を表示",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "SpendingHeatmap",
              "label": "今月の支出カレンダー",
              "minWidth": "120dp",
              "minHeight": "60dp",
              "maxResizeWidth": "120dp",
              "maxResizeHeight": "60dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "none",
              "description": "GitHubの草グラフ風に日別支出を表示",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-web-browser",
      "expo-quick-actions",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b3bb31f-3a8b-4002-b028-8f39bb290c2f"
      }
    },
    "owner": "yukkuripannda"
  }
}
