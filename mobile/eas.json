{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      },
      "distribution": "internal",
      "node": "20.18.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://raku-bo-backend.funa-hayate.workers.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "20.18.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://raku-bo-backend.funa-hayate.workers.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
